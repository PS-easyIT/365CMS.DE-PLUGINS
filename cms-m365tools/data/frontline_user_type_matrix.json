  "device_models": {
    "shared_device": {
      "label": "Shared Device",
      "frontline_delta": 14,
      "f1_fit_delta": 8,
      "f3_fit_delta": 6,
      "risk_delta": 8,
      "guidance": "Shared Device passt gut zu Schicht- und Standortarbeit, braucht aber klare Anmeldung, Abmeldung und Geräteverwaltung.",
      "security_guidance": "Shared Device Mode, Conditional Access und App-Schutzrichtlinien einplanen."
    },
    "byod": {
      "label": "Privates Smartphone",
      "frontline_delta": 8,
      "f1_fit_delta": 4,
      "f3_fit_delta": 6,
      "risk_delta": 10,
      "guidance": "BYOD ist praktisch für Schichtpläne, Chat und HR-Informationen, muss aber arbeitsrechtlich und technisch passen.",
      "security_guidance": "App-Schutz, Zugriffskontrollen und klare BYOD-Regeln vorbereiten."
    },
    "company_smartphone": {
      "label": "Firmen-Smartphone",
      "frontline_delta": 10,
      "f1_fit_delta": 5,
      "f3_fit_delta": 8,
      "risk_delta": 4,
      "guidance": "Firmen-Smartphones eignen sich für mobile Kommunikation, Aufgaben, Formulare und Außendienstprozesse.",
      "security_guidance": "Mobile Device Management und App-Schutzrichtlinien einplanen."
    },
    "dedicated_device": {
      "label": "Dediziertes Gerät",
      "frontline_delta": 0,
      "f1_fit_delta": -2,
      "f3_fit_delta": 3,
      "risk_delta": 3,
      "guidance": "Ein persönliches Gerät kann Frontline sein, deutet bei viel Desktop-Arbeit aber eher auf F3 oder Enterprise hin.",
      "security_guidance": "Geräte-Compliance und Zugriffskontrollen prüfen."
    },
    "kiosk_terminal": {
      "label": "Kiosk / Terminal",
      "frontline_delta": -8,
      "f1_fit_delta": -10,
      "f3_fit_delta": -8,
      "risk_delta": 24,
      "guidance": "Kiosk-Modelle sind nur für sehr eng gefasste Aufgaben geeignet und liefern oft keine gute Nutzerzuordnung.",
      "security_guidance": "Für Zusammenarbeit, Audit und nutzerbasierte Schutzfunktionen besser identitätsbasierte Modelle prüfen."
    }
