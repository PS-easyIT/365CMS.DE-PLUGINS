{
  "meta": {
    "title": "AI Use Case Matrix",
    "source_checked": "2026-05-16",
    "description": "Bewertungsmatrix für die Auswahl zwischen Copilot Chat, Microsoft 365 Copilot, Spezial-Copilots, Copilot Studio und dynamischen AI-Angeboten."
  },
  "roles": {
    "knowledge_worker": "Wissensarbeit / Office",
    "executive": "Management / Assistenz",
    "sales": "Sales / Account Management",
    "service": "Service / Support",
    "security": "Security / Compliance / IT Ops",
    "developer": "Entwicklung / DevOps",
    "process_team": "Prozess- und Fachabteilung",
    "personal": "Privater Einzelbedarf"
  },
  "data_scopes": {
    "web": "Webrecherche und frei zugängliche Inhalte",
    "work": "Microsoft-365-Arbeitsdaten, Dateien, Mails, Teams, Meetings",
    "crm": "CRM, Sales, Customer- oder Service-Daten",
    "ticketing": "Ticket-, Service-Desk- oder Prozessdaten",
    "security": "Security-Signale, Alerts, Defender, Sentinel, Intune, Entra",
    "code": "Quellcode, Repositories, Pull Requests, Developer Tools",
    "process": "Eigene Prozesse, APIs, Formulare, Workflows"
  },
  "goals": {
    "quick_research": "Schnelle Recherche und Entwürfe",
    "personal_assistant": "Persönlicher Assistent ohne umfassendes Organisationswissen",
    "org_knowledge": "Antworten auf Basis von Unternehmenswissen",
    "in_app_productivity": "Produktivität direkt in Microsoft-365-Apps",
    "role_specialist": "Spezialisierte Rolle oder Fachdomäne",
    "custom_agents": "Eigene Agents, Knowledge Sources oder Workflows",
    "developer_productivity": "Code, Reviews, Tests und Developer-Workflows",
    "incident_response": "Incident Response und Security Operations"
  },
  "score_rules": {
    "role_match": 24,
    "data_scope_match": 30,
    "goal_match": 26,
    "sensitive_business_data_fit": 10,
    "admin_governance_fit": 6,
    "dynamic_offer_selected": 8,
    "custom_agent_bonus": 16,
    "manual_review_penalty": -4,
    "consumer_sensitive_penalty": -45,
    "wrong_domain_penalty": -35
  },
  "shortcuts": [
    {
      "when": {"role": "security"},
      "prefer": "security-copilot",
      "reason": "Security-Rollen benötigen Security-Datenquellen, Incident-Kontext und Defender/Sentinel/Intune/Entra-Integration."
    },
    {
      "when": {"role": "developer"},
      "prefer": "github-copilot",
      "reason": "Developer-Workflows gehören in GitHub Copilot statt in einen Office-orientierten Assistenten."
    },
    {
      "when": {"data_scope": "work"},
      "prefer": "microsoft-365-copilot",
      "reason": "Microsoft-365-Arbeitsdaten und Graph-Kontext sprechen für Microsoft 365 Copilot."
    },
    {
      "when": {"goal": "custom_agents"},
      "prefer": "copilot-studio",
      "reason": "Eigene Agents, Knowledge Sources, Topics, Tools und Workflows gehören primär in Copilot Studio."
    },
    {
      "when": {"data_scope": "web", "goal": "quick_research"},
      "prefer": "copilot-chat",
      "reason": "Für sichere Webrecherche und Entwürfe reicht häufig Copilot Chat als Einstieg."
    }
  ]
}
