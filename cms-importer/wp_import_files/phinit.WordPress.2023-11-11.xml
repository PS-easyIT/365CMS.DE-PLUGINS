<figure class="wp-block-table is-style-stripes"><table><tbody><tr><td><strong>Kategorie</strong></td><td><strong>Begriff</strong></td><td><strong>Beschreibung</strong></td></tr><tr><td>Identitäts- und Zugriffsverwaltung</td><td>Azure Active Directory <br>(Azure AD)</td><td>Microsofts cloudbasierter Identitäts- und Zugriffsverwaltungsdienst.</td></tr><tr><td>Identitäts- und Zugriffsverwaltung</td><td>Azure Role Based Access Control (RBAC)</td><td>System zur Autorisierung von Zugriffen auf Azure-Ressourcen.</td></tr><tr><td>Identitäts- und Zugriffsverwaltung</td><td>Azure Roles (Rollen)</td><td>Wichtige Komponente der rollenbasierten Zugriffssteuerung (RBAC) in Azure.</td></tr><tr><td>Identitäts- und Zugriffsverwaltung</td><td>Bedingter Zugriff</td><td>Funktion von EntraID</td></tr><tr><td>Identitäts- und Zugriffsverwaltung</td><td>Identity Access Management (IAM)</td><td>Rahmenwerk aus Richtlinien, Prozessen und Technologien zur Verwaltung digitaler Identitäten.</td></tr><tr><td>Identitäts- und Zugriffsverwaltung</td><td>Identity Protection &amp; Governance</td><td>Erkennung, Untersuchung und Behebung von identitätsbasierten Risiken.</td></tr><tr><td>Identitäts- und Zugriffsverwaltung</td><td>Privileged Identity Management (PIM)</td><td>Dienst in Microsoft Entra ID zur Verwaltung des Zugriffs auf wichtige Ressourcen.</td></tr><tr><td>Identitäts- und Zugriffsverwaltung</td><td>Single Sign-On</td><td>Authentifizierungsverfahren, das es Benutzern ermöglicht, sich einmalig anzumelden.</td></tr><tr><td>Infrastruktur und Netzwerk</td><td>Azure Application Gateway</td><td>Web-Traffic-Load-Balancer, der Anwendungen vor Webbedrohungen schützt.</td></tr><tr><td>Infrastruktur und Netzwerk</td><td>Azure ExpressRoute</td><td>Ermöglicht eine private Verbindung zwischen Azure-Rechenzentren und Unternehmensinfrastruktur.</td></tr><tr><td>Infrastruktur und Netzwerk</td><td>Azure Traffic Manager</td><td>DNS-basierter Lastverteilungsdienst, der den eingehenden Verkehr verteilt.</td></t