<!-- /wp:image --></div>
<!-- /wp:column --></div>
<!-- /wp:columns -->

<!-- wp:paragraph -->
<p></p>
<!-- /wp:paragraph -->

<!-- wp:list {"ordered":true} -->
<ol><!-- wp:list-item -->
<li>Version <strong>11.52</strong> <strong>installieren</strong> und aus dem Programm Verzeichnis die Jabra SDK Dateien sichern&nbsp;</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Version <strong>11.52 deinstallieren</strong> und die <strong>passende Server Version installieren</strong></li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Jabra SDK Dateien in das Programm Verzeichnis kopieren und die vorhandenen ersetzten lassen&nbsp;</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>System neu starten und freuen :-)&nbsp;</li>
<!-- /wp:list-item --></ol>
<!-- /wp:list --></div>
<!-- /wp:column --></div>
