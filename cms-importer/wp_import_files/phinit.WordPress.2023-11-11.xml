<figure class="wp-block-table"><table><tbody><tr><td><em>Features / Pläne</em></td><td>EntraID<br><strong>Free</strong></td><td>EntraID<br><strong>O365 Apps</strong></td><td>EntraID<br><strong>Premium P1</strong></td><td>EntraID<br><strong>Premium P2</strong></td></tr><tr><td colspan="5"><strong>Benutzer- und Gruppenverwaltung</strong></td></tr><tr><td>Unbegrenzte Anzahl von Benutzern</td><td>Ja</td><td>Ja</td><td>Ja</td><td>Ja</td></tr><tr><td>Self-Service-Gruppenverwaltung</td><td>Ja</td><td>Ja</td><td>Ja</td><td>Ja</td></tr><tr><td>Single Sign-On (SSO)</td><td>Ja</td><td>Ja</td><td>Ja</td><td>Ja</td></tr><tr><td>Automatisierte Benutzerbereitstellung</td><td>Nein</td><td>Ja</td><td>Ja</td><td>Ja</td></tr><tr><td colspan="5"><strong>Sicherheit</strong></td></tr><tr><td>Multifaktor-<br>Authentifizierung</td><td>Ja</td><td>Ja</td><td>Ja</td><td>Ja</td></tr><tr><td>Bedingter Zugriff</td><td>Nein</td><td>Ja</td><td>Ja</td><td>Ja</td></tr><tr><td>Identitätsschutz</td><td>Nein</td><td>Nein</td><td>Ja</td><td>Ja</td></tr><tr><td>Sicherheitsberichte und -warnungen</td><td>Eingeschränkt</td><td>Eingeschränkt</td><td>Ja</td><td>Ja</td></tr><tr><td colspan="5"><strong>Verwaltung</strong></td></tr><tr><td>Self-Service-Passwortzurücksetzung</td><td>Für Cloud-Benutzer</td><td>Für Cloud-Benutzer</td><td>Für alle Benutzer</td><td>Für alle Benutzer</td></tr><tr><td>Delegierte Gruppenverwaltung</td><td>Nein</td><td>Nein</td><td>Ja</td><td>Ja</td></tr><tr><td>Dynamische Gruppen</td><td>Nein</td><td>Nein</td><td>Ja</td><td>Ja</td></tr><tr><td>Gruppenbasierte Zugriffsverwaltung</td><td>Nein</td><td>Ja</td><td>Ja</td><td>Ja</td></tr><tr><td colspan="5"><strong>Erweiterte Funktionen</strong></td></tr><tr><td>Anwendungsproxy</td><td>Nein</td><td>Nein</td><td>Ja</td><td>Ja</td></tr><tr><td>Cloud App Discovery</td><td>Nein</td><td>Nein</td><td>Ja</td><td>Ja</td></tr><tr><td>Privilegierte Identitätsverwaltung</td><td>Nein</td><td>Nein</td><td>Nein</td><td>Ja</td></tr><tr><td>Risikobasierte b